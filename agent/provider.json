    },
    {
      "id": "validator-tests",
      "argv": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "scripts",
        "-p",
        "test_*.py"
      ],
      "environment": "python; disposable checkout",
      "purpose": "Validation and packaging regressions"
    },
    {
      "id": "sdk",
      "argv": [
        "dotnet",
        "test",
        "GamePlatform.sln",
        "-c",
        "Release"
      ],
      "environment": "dotnet; disposable checkout",
      "purpose": "Affected SDK runtime tests"
    },
    {
      "id": "package",
      "argv": [
        "python3",
        "scripts/package-sdk.py"
      ],
      "environment": "dotnet; disposable checkout",
      "purpose": "Generate deterministic unpublished package"
    },
    {
      "id": "upm",
      "argv": [
        "python3",
        "scripts/build-upm-package.py",
        "--verify"
      ],
      "environment": "dotnet; disposable checkout",
      "purpose": "Verify generated Git UPM payload"
    }
  ],
  "packages": [
    {
      "id": "com.gindemit.game-platform",
      "role": "producer",
      "inputs": [
        {
          "path": "upm/com.gindemit.game-platform/package-content-manifest.json",
          "keys": [
            "sourceCommit"
          ]
        },
        {
          "path": "upm/com.gindemit.game-platform/package-content-manifest.json",
          "keys": [
            "version"
          ]
        },
        {
          "path": "upm/com.gindemit.game-platform/package-content-manifest.json",
          "keys": [
            "sourceBundleManifestSha256"
          ]
        }
      ]
    }
