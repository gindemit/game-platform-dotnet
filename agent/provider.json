          "path": "upm/com.gindemit.game-platform/package-content-manifest.json",
          "keys": [
            "sourceCommit"
          ]
        },
        {
          "path": "upm/com.gindemit.game-platform/package-content-manifest.json",
          "keys": [
            "version"
          ]
        },
        {
          "path": "upm/com.gindemit.game-platform/package-content-manifest.json",
