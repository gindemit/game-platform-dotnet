{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://contracts.gindemit.invalid/v1/schemas/push.schema.json","$defs":{
    "operation":{"type":"object","additionalProperties":false,"required":["operationId","installationId","sequence","type","schemaVersion","clientCreatedAt","payload"],"properties":{"operationId":{"$ref":"common.schema.json#/$defs/uuid"},"installationId":{"$ref":"common.schema.json#/$defs/uuid"},"sequence":{"$ref":"common.schema.json#/$defs/positiveInt64"},"type":{"enum":["profile.patch","gameplay.session.completed"]},"schemaVersion":{"const":1},"clientCreatedAt":{"$ref":"common.schema.json#/$defs/timestamp"},"payload":{"type":"object"}},"allOf":[{"if":{"properties":{"type":{"const":"profile.patch"}}},"then":{"properties":{"payload":{"$ref":"profile.schema.json#/$defs/patchCommand"}}}},{"if":{"properties":{"type":{"const":"gameplay.session.completed"}}},"then":{"properties":{"payload":{"$ref":"gameplay.schema.json#/$defs/completionCommand"}}}}]},
    "request":{"type":"object","additionalProperties":false,"required":["protocolVersion","clientStreamId","operations"],"properties":{"protocolVersion":{"$ref":"common.schema.json#/$defs/protocolVersion"},"clientStreamId":{"$ref":"common.schema.json#/$defs/uuid"},"operations":{"type":"array","minItems":1,"maxItems":64,"items":{"$ref":"#/$defs/operation"}}}},
    "accepted":{"type":"object","additionalProperties":false,"required":["operationId","sequence","status","feedRevision","result"],"properties":{"operationId":{"$ref":"common.schema.json#/$defs/uuid"},"sequence":{"$ref":"common.schema.json#/$defs/positiveInt64"},"status":{"const":"accepted"},"feedRevision":{"$ref":"common.schema.json#/$defs/nonNegativeInt64"},"result":{"oneOf":[{"type":"object","additionalProperties":false,"required":["kind","profileRevision"],"properties":{"kind":{"const":"profile_updated"},"profileRevision":{"$ref":"common.schema.json#/$defs/nonNegativeInt64"}}},{"type":"object","additionalProperties":false,"required":["kind","completionRecorded"],"properties":{"kind":{"const":"gameplay_completion_recorded"},"completionRecorded":{"const":true}}}]}}},
    "terminalRejected":{"type":"object","additionalProperties":false,"required":["operationId","sequence","status","error"],"properties":{"operationId":{"$ref":"common.schema.json#/$defs/uuid"},"sequence":{"$ref":"common.schema.json#/$defs/positiveInt64"},"status":{"const":"terminal_rejected"},"error":{"$ref":"common.schema.json#/$defs/error"}},"allOf":[{"properties":{"error":{"properties":{"retryable":{"const":false}}}}}]},
    "waiting":{"type":"object","additionalProperties":false,"required":["operationId","sequence","status","expectedSequence"],"properties":{"operationId":{"$ref":"common.schema.json#/$defs/uuid"},"sequence":{"$ref":"common.schema.json#/$defs/positiveInt64"},"status":{"const":"waiting_for_sequence"},"expectedSequence":{"$ref":"common.schema.json#/$defs/positiveInt64"}}},
    "retryable":{"type":"object","additionalProperties":false,"required":["operationId","sequence","status","error"],"properties":{"operationId":{"$ref":"common.schema.json#/$defs/uuid"},"sequence":{"$ref":"common.schema.json#/$defs/positiveInt64"},"status":{"const":"retryable"},"error":{"$ref":"common.schema.json#/$defs/error"}},"allOf":[{"properties":{"error":{"properties":{"retryable":{"const":true}}}}}]},
    "upgradeRequired":{"type":"object","additionalProperties":false,"required":["operationId","sequence","status","minimumProtocolVersion","error"],"properties":{"operationId":{"$ref":"common.schema.json#/$defs/uuid"},"sequence":{"$ref":"common.schema.json#/$defs/positiveInt64"},"status":{"const":"upgrade_required"},"minimumProtocolVersion":{"type":"integer","minimum":2},"error":{"$ref":"common.schema.json#/$defs/error"}}},
    "result":{"oneOf":[{"$ref":"#/$defs/accepted"},{"$ref":"#/$defs/terminalRejected"},{"$ref":"#/$defs/waiting"},{"$ref":"#/$defs/retryable"},{"$ref":"#/$defs/upgradeRequired"}]},
    "response":{"type":"object","additionalProperties":false,"required":["protocolVersion","clientStreamId","operationResults","finalizedThrough","serverTime"],"properties":{"protocolVersion":{"$ref":"common.schema.json#/$defs/protocolVersion"},"clientStreamId":{"$ref":"common.schema.json#/$defs/uuid"},"operationResults":{"type":"array","minItems":1,"maxItems":64,"items":{"$ref":"#/$defs/result"}},"finalizedThrough":{"$ref":"common.schema.json#/$defs/nonNegativeInt64"},"serverTime":{"$ref":"common.schema.json#/$defs/timestamp"}}}
  }
}
