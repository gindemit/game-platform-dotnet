{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://contracts.gindemit.invalid/v1/schemas/profiles.schema.json","title":"Authenticated public profile read","$defs":{
    "publicQueryRequest":{"type":"object","additionalProperties":false,"required":["protocolVersion","playerId"],"properties":{"protocolVersion":{"$ref":"common.schema.json#/$defs/protocolVersion"},"playerId":{"$ref":"common.schema.json#/$defs/uuidV7"}}},
    "publicProfile":{"type":"object","additionalProperties":false,"required":["displayName","avatarKey","locale","revision"],"properties":{"displayName":{"type":"string","minLength":1,"maxLength":64},"avatarKey":{"oneOf":[{"$ref":"common.schema.json#/$defs/semanticKey"},{"type":"null"}]},"locale":{"oneOf":[{"type":"string","pattern":"^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$","maxLength":35},{"type":"null"}]},"revision":{"$ref":"common.schema.json#/$defs/nonNegativeInt64"}}},
    "publicTeam":{"type":"object","additionalProperties":false,"required":["teamId","name","badgeId"],"properties":{"teamId":{"$ref":"common.schema.json#/$defs/uuid"},"name":{"type":"string","minLength":3,"maxLength":24},"badgeId":{"type":"string","minLength":1,"maxLength":48}}},
    "publicQueryResponse":{"type":"object","additionalProperties":false,"required":["protocolVersion","appId","playerId","serverTime","profile","team"],"properties":{"protocolVersion":{"$ref":"common.schema.json#/$defs/protocolVersion"},"appId":{"$ref":"common.schema.json#/$defs/uuid"},"playerId":{"$ref":"common.schema.json#/$defs/uuidV7"},"serverTime":{"$ref":"common.schema.json#/$defs/timestamp"},"profile":{"oneOf":[{"$ref":"#/$defs/publicProfile"},{"type":"null"}]},"team":{"oneOf":[{"$ref":"#/$defs/publicTeam"},{"type":"null"}]}}}
  }
}
