{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.gindemit.invalid/v1/schemas/daily.schema.json",
  "title": "Server-owned daily claim status query and daily.claim command results",
  "$defs": {
    "utcDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "cycleDay": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "policyVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "plannedLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "resourceId", "quantity"],
      "properties": {
        "kind": { "enum": ["currency", "item_stack"] },
        "resourceId": { "$ref": "common.schema.json#/$defs/semanticKey" },
        "quantity": { "$ref": "common.schema.json#/$defs/positiveInt64" }
      }
    },
    "receiptLines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "oneOf": [
          { "$ref": "https://contracts.gindemit.invalid/live-slice/receipt.1.schema.json#/$defs/currencyLine" },
          { "$ref": "https://contracts.gindemit.invalid/live-slice/receipt.1.schema.json#/$defs/stackLine" }
        ]
      }
    },
    "historyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["utcDate", "cycleDay", "claimId", "policyVersion", "lines"],
      "properties": {
        "utcDate": { "$ref": "#/$defs/utcDate" },
        "cycleDay": { "$ref": "#/$defs/cycleDay" },
        "claimId": { "$ref": "common.schema.json#/$defs/uuidV7" },
        "policyVersion": { "$ref": "#/$defs/policyVersion" },
        "lines": { "$ref": "#/$defs/receiptLines" }
      }
    },
    "statusRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "statusResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serverTime", "utcDate", "nextUtcDayAt", "eligible", "cycleDay", "policyVersion", "reward", "history"],
      "properties": {
        "serverTime": { "$ref": "common.schema.json#/$defs/timestamp" },
        "utcDate": { "$ref": "#/$defs/utcDate" },
        "nextUtcDayAt": { "$ref": "common.schema.json#/$defs/timestamp" },
        "eligible": { "type": "boolean" },
        "cycleDay": { "$ref": "#/$defs/cycleDay" },
        "policyVersion": { "$ref": "#/$defs/policyVersion" },
        "reward": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/plannedLine" }
        },
        "history": {
          "type": "array",
          "maxItems": 7,
          "items": { "$ref": "#/$defs/historyEntry" }
        }
      }
    },
    "claimCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["utcDate"],
      "properties": {
        "utcDate": { "$ref": "#/$defs/utcDate" }
      }
    },
    "claimResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "claimId", "originatingOperationId", "utcDate", "cycleDay", "policyVersion", "lines"],
      "properties": {
        "kind": { "const": "daily_claimed" },
        "claimId": { "$ref": "common.schema.json#/$defs/uuidV7" },
        "originatingOperationId": { "$ref": "common.schema.json#/$defs/uuid" },
        "utcDate": { "$ref": "#/$defs/utcDate" },
        "cycleDay": { "$ref": "#/$defs/cycleDay" },
        "policyVersion": { "$ref": "#/$defs/policyVersion" },
        "lines": { "$ref": "#/$defs/receiptLines" }
      },
      "x-orderedLineIndices": true
    }
  }
}
