{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://contracts.gindemit.invalid/v1/schemas/projection.schema.json","$defs":{
    "profileKey":{"type":"object","additionalProperties":false,"required":["profile"],"properties":{"profile":{"const":"self"}}},
    "progressionKey":{"type":"object","additionalProperties":false,"required":["stateKey"],"properties":{"stateKey":{"$ref":"common.schema.json#/$defs/semanticKey"}}},
    "inventoryKey":{"type":"object","additionalProperties":false,"required":["itemId"],"properties":{"itemId":{"$ref":"common.schema.json#/$defs/semanticKey"}}},
    "walletKey":{"type":"object","additionalProperties":false,"required":["currencyId"],"properties":{"currencyId":{"$ref":"common.schema.json#/$defs/semanticKey"}}},
    "entitlementKey":{"type":"object","additionalProperties":false,"required":["entitlementId"],"properties":{"entitlementId":{"$ref":"common.schema.json#/$defs/semanticKey"}}},
    "progressionData":{"type":"object","additionalProperties":false,"required":["value"],"properties":{"value":{"$ref":"common.schema.json#/$defs/nonNegativeInt64"}}},
    "inventoryData":{"type":"object","additionalProperties":false,"required":["quantity"],"properties":{"quantity":{"$ref":"common.schema.json#/$defs/nonNegativeInt64"}}},
    "walletData":{"type":"object","additionalProperties":false,"required":["balance"],"properties":{"balance":{"$ref":"common.schema.json#/$defs/nonNegativeInt64"}}},
    "entitlementData":{"type":"object","additionalProperties":false,"required":["active","expiresAt"],"properties":{"active":{"type":"boolean"},"expiresAt":{"oneOf":[{"$ref":"common.schema.json#/$defs/timestamp"},{"type":"null"}]}}},
    "snapshotEntity":{"oneOf":[
      {"$ref":"#/$defs/profileSnapshot"},{"$ref":"#/$defs/progressionSnapshot"},{"$ref":"#/$defs/inventorySnapshot"},{"$ref":"#/$defs/walletSnapshot"},{"$ref":"#/$defs/entitlementSnapshot"}
    ]},
    "profileSnapshot":{"type":"object","additionalProperties":false,"required":["collection","entityKey","revision","data"],"properties":{"collection":{"const":"profile"},"entityKey":{"$ref":"#/$defs/profileKey"},"revision":{"$ref":"common.schema.json#/$defs/nonNegativeInt64"},"data":{"$ref":"profile.schema.json#/$defs/profile"}}},
    "progressionSnapshot":{"type":"object","additionalProperties":false,"required":["collection","entityKey","revision","data"],"properties":{"collection":{"const":"progression"},"entityKey":{"$ref":"#/$defs/progressionKey"},"revision":{"$ref":"common.schema.json#/$defs/nonNegativeInt64"},"data":{"$ref":"#/$defs/progressionData"}}},
    "inventorySnapshot":{"type":"object","additionalProperties":false,"required":["collection","entityKey","revision","data"],"properties":{"collection":{"const":"inventory"},"entityKey":{"$ref":"#/$defs/inventoryKey"},"revision":{"$ref":"common.schema.json#/$defs/nonNegativeInt64"},"data":{"$ref":"#/$defs/inventoryData"}}},
    "walletSnapshot":{"type":"object","additionalProperties":false,"required":["collection","entityKey","revision","data"],"properties":{"collection":{"const":"wallet"},"entityKey":{"$ref":"#/$defs/walletKey"},"revision":{"$ref":"common.schema.json#/$defs/nonNegativeInt64"},"data":{"$ref":"#/$defs/walletData"}}},
    "entitlementSnapshot":{"type":"object","additionalProperties":false,"required":["collection","entityKey","revision","data"],"properties":{"collection":{"const":"entitlements"},"entityKey":{"$ref":"#/$defs/entitlementKey"},"revision":{"$ref":"common.schema.json#/$defs/nonNegativeInt64"},"data":{"$ref":"#/$defs/entitlementData"}}},
    "change":{"oneOf":[{"$ref":"#/$defs/profileChange"},{"$ref":"#/$defs/progressionChange"},{"$ref":"#/$defs/inventoryChange"},{"$ref":"#/$defs/walletChange"},{"$ref":"#/$defs/entitlementChange"}]},
    "profileChange":{"$ref":"#/$defs/profileChangeUnion"},
    "profileChangeUnion":{"oneOf":[{"$ref":"#/$defs/profileUpsert"},{"$ref":"#/$defs/profileRemoval"}]},
    "progressionChange":{"oneOf":[{"$ref":"#/$defs/progressionUpsert"},{"$ref":"#/$defs/progressionRemoval"}]},
    "inventoryChange":{"oneOf":[{"$ref":"#/$defs/inventoryUpsert"},{"$ref":"#/$defs/inventoryRemoval"}]},
    "walletChange":{"oneOf":[{"$ref":"#/$defs/walletUpsert"},{"$ref":"#/$defs/walletRemoval"}]},
    "entitlementChange":{"oneOf":[{"$ref":"#/$defs/entitlementUpsert"},{"$ref":"#/$defs/entitlementRemoval"}]},
    "profileUpsert":{"type":"object","additionalProperties":false,"required":["entityType","entityKey","revision","kind","data"],"properties":{"entityType":{"const":"profile"},"entityKey":{"$ref":"#/$defs/profileKey"},"revision":{"$ref":"common.schema.json#/$defs/nonNegativeInt64"},"kind":{"const":"upsert"},"data":{"$ref":"profile.schema.json#/$defs/profile"}}},
    "progressionUpsert":{"type":"object","additionalProperties":false,"required":["entityType","entityKey","revision","kind","data"],"properties":{"entityType":{"const":"progression"},"entityKey":{"$ref":"#/$defs/progressionKey"},"revision":{"$ref":"common.schema.json#/$defs/nonNegativeInt64"},"kind":{"const":"upsert"},"data":{"$ref":"#/$defs/progressionData"}}},
    "inventoryUpsert":{"type":"object","additionalProperties":false,"required":["entityType","entityKey","revision","kind","data"],"properties":{"entityType":{"const":"inventory"},"entityKey":{"$ref":"#/$defs/inventoryKey"},"revision":{"$ref":"common.schema.json#/$defs/nonNegativeInt64"},"kind":{"const":"upsert"},"data":{"$ref":"#/$defs/inventoryData"}}},
    "walletUpsert":{"type":"object","additionalProperties":false,"required":["entityType","entityKey","revision","kind","data"],"properties":{"entityType":{"const":"wallet"},"entityKey":{"$ref":"#/$defs/walletKey"},"revision":{"$ref":"common.schema.json#/$defs/nonNegativeInt64"},"kind":{"const":"upsert"},"data":{"$ref":"#/$defs/walletData"}}},
    "entitlementUpsert":{"type":"object","additionalProperties":false,"required":["entityType","entityKey","revision","kind","data"],"properties":{"entityType":{"const":"entitlements"},"entityKey":{"$ref":"#/$defs/entitlementKey"},"revision":{"$ref":"common.schema.json#/$defs/nonNegativeInt64"},"kind":{"const":"upsert"},"data":{"$ref":"#/$defs/entitlementData"}}},
    "profileRemoval":{"$ref":"#/$defs/profileRemovalValue"},
    "profileRemovalValue":{"type":"object","additionalProperties":false,"required":["entityType","entityKey","revision","kind"],"properties":{"entityType":{"const":"profile"},"entityKey":{"$ref":"#/$defs/profileKey"},"revision":{"$ref":"common.schema.json#/$defs/nonNegativeInt64"},"kind":{"enum":["tombstone","view_remove","invalidation"]}}},
    "progressionRemoval":{"type":"object","additionalProperties":false,"required":["entityType","entityKey","revision","kind"],"properties":{"entityType":{"const":"progression"},"entityKey":{"$ref":"#/$defs/progressionKey"},"revision":{"$ref":"common.schema.json#/$defs/nonNegativeInt64"},"kind":{"enum":["tombstone","view_remove","invalidation"]}}},
    "inventoryRemoval":{"type":"object","additionalProperties":false,"required":["entityType","entityKey","revision","kind"],"properties":{"entityType":{"const":"inventory"},"entityKey":{"$ref":"#/$defs/inventoryKey"},"revision":{"$ref":"common.schema.json#/$defs/nonNegativeInt64"},"kind":{"enum":["tombstone","view_remove","invalidation"]}}},
    "walletRemoval":{"type":"object","additionalProperties":false,"required":["entityType","entityKey","revision","kind"],"properties":{"entityType":{"const":"wallet"},"entityKey":{"$ref":"#/$defs/walletKey"},"revision":{"$ref":"common.schema.json#/$defs/nonNegativeInt64"},"kind":{"enum":["tombstone","view_remove","invalidation"]}}},
    "entitlementRemoval":{"type":"object","additionalProperties":false,"required":["entityType","entityKey","revision","kind"],"properties":{"entityType":{"const":"entitlements"},"entityKey":{"$ref":"#/$defs/entitlementKey"},"revision":{"$ref":"common.schema.json#/$defs/nonNegativeInt64"},"kind":{"enum":["tombstone","view_remove","invalidation"]}}}
  }
}
