{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.gindemit.invalid/native-purchases/schema.json",
  "$defs": {
    "productsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "productsResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "products"
      ],
      "properties": {
        "products": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "productId",
              "productVersion",
              "provider",
              "packageName",
              "storeProductId",
              "productType",
              "environment",
              "contents"
            ],
            "properties": {
              "productId": {
                "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/semanticKey"
              },
              "productVersion": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "provider": {
                "const": "google_play"
              },
              "packageName": {
                "type": "string",
                "minLength": 3,
                "maxLength": 255,
                "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
              },
              "storeProductId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "productType": {
                "const": "consumable"
              },
              "environment": {
                "enum": [
                  "test",
                  "live"
                ]
              },
              "contents": {
                "type": "array",
                "minItems": 1,
                "maxItems": 63,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "currencyId",
                        "quantity"
                      ],
                      "properties": {
                        "kind": {
                          "const": "currency"
                        },
                        "currencyId": {
                          "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/semanticKey"
                        },
                        "quantity": {
                          "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/positiveInt64"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "itemId",
                        "quantity"
                      ],
                      "properties": {
                        "kind": {
                          "const": "item_stack"
                        },
                        "itemId": {
                          "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/semanticKey"
                        },
                        "quantity": {
                          "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/positiveInt64"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "intentRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intentKey",
        "productId",
        "productVersion",
        "source"
      ],
      "properties": {
        "intentKey": {
          "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/uuidV7"
        },
        "productId": {
          "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/semanticKey"
        },
        "productVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "source": {
          "enum": [
            "purchase",
            "recovery"
          ]
        }
      }
    },
    "proofRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intentId",
        "purchaseToken"
      ],
      "properties": {
        "intentId": {
          "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/uuidV7"
        },
        "purchaseToken": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "x-maximumUtf8Bytes": 8192
        }
      }
    },
    "recoverProofRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intentKey",
        "provider",
        "packageName",
        "storeProductId",
        "purchaseToken"
      ],
      "properties": {
        "intentKey": {
          "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/uuidV7"
        },
        "provider": {
          "const": "google_play"
        },
        "packageName": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "storeProductId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "purchaseToken": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "x-maximumUtf8Bytes": 8192
        }
      }
    },
    "statusRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intentId"
      ],
      "properties": {
        "intentId": {
          "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/uuidV7"
        }
      }
    },
    "recoveryRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "afterIntentId",
        "limit"
      ],
      "properties": {
        "afterIntentId": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/uuidV7"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      }
    },
    "intentState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intentId",
        "intentKey",
        "productId",
        "productVersion",
        "provider",
        "packageName",
        "storeProductId",
        "productType",
        "environment",
        "customerBinding",
        "source",
        "launchAllowed",
        "state",
        "reason",
        "finishState",
        "retryAfterMilliseconds",
        "receipt"
      ],
      "properties": {
        "intentId": {
          "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/uuidV7"
        },
        "intentKey": {
          "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/uuidV7"
        },
        "productId": {
          "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/semanticKey"
        },
        "productVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "provider": {
          "const": "google_play"
        },
        "packageName": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "storeProductId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "productType": {
          "const": "consumable"
        },
        "environment": {
          "enum": [
            "test",
            "live"
          ]
        },
        "customerBinding": {
          "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/uuidV7"
        },
        "source": {
          "enum": [
            "purchase",
            "recovery"
          ]
        },
        "launchAllowed": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "awaiting_proof",
            "pending_store",
            "pending_verification",
            "held",
            "rejected",
            "granted"
          ]
        },
        "reason": {
          "enum": [
            null,
            "provider_pending",
            "provider_cancelled",
            "invalid_proof",
            "account_binding_mismatch",
            "product_mismatch",
            "environment_mismatch",
            "unsupported_quantity",
            "unsupported_product",
            "consumed_without_ledger",
            "catalog_changed_or_unavailable",
            "value_limit",
            "authorization_changed",
            "verification_unavailable",
            "finalization_unavailable",
            "integrity_unavailable"
          ]
        },
        "finishState": {
          "enum": [
            "not_required",
            "pending",
            "finished"
          ]
        },
        "retryAfterMilliseconds": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            }
          ]
        },
        "receipt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "chargeId",
                "grantId",
                "originatingIntentId",
                "originalFeedRevision",
                "lines",
                "deliveryCheckpoint"
              ],
              "properties": {
                "chargeId": {
                  "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/uuidV7"
                },
                "grantId": {
                  "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/uuidV7"
                },
                "originatingIntentId": {
                  "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/uuidV7"
                },
                "originalFeedRevision": {
                  "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/positiveInt64"
                },
                "lines": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 63,
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "lineIndex",
                          "definitionVersion",
                          "kind",
                          "currencyId",
                          "quantity"
                        ],
                        "properties": {
                          "lineIndex": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 62
                          },
                          "definitionVersion": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 2147483647
                          },
                          "kind": {
                            "const": "currency"
                          },
                          "currencyId": {
                            "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/semanticKey"
                          },
                          "quantity": {
                            "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/positiveInt64"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "lineIndex",
                          "definitionVersion",
                          "kind",
                          "itemId",
                          "quantity"
                        ],
                        "properties": {
                          "lineIndex": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 62
                          },
                          "definitionVersion": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 2147483647
                          },
                          "kind": {
                            "const": "item_stack"
                          },
                          "itemId": {
                            "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/semanticKey"
                          },
                          "quantity": {
                            "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/positiveInt64"
                          }
                        }
                      }
                    ]
                  }
                },
                "deliveryCheckpoint": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "feedRevision",
                    "visibilityGeneration",
                    "logEpoch"
                  ],
                  "properties": {
                    "feedRevision": {
                      "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/positiveInt64"
                    },
                    "visibilityGeneration": {
                      "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/positiveInt64"
                    },
                    "logEpoch": {
                      "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/uuid"
                    }
                  }
                }
              },
              "x-orderedLineIndices": true
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "granted"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "receipt": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "chargeId",
                  "grantId",
                  "originatingIntentId",
                  "originalFeedRevision",
                  "lines",
                  "deliveryCheckpoint"
                ],
                "properties": {
                  "chargeId": {
                    "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/uuidV7"
                  },
                  "grantId": {
                    "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/uuidV7"
                  },
                  "originatingIntentId": {
                    "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/uuidV7"
                  },
                  "originalFeedRevision": {
                    "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/positiveInt64"
                  },
                  "lines": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 63,
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "lineIndex",
                            "definitionVersion",
                            "kind",
                            "currencyId",
                            "quantity"
                          ],
                          "properties": {
                            "lineIndex": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 62
                            },
                            "definitionVersion": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 2147483647
                            },
                            "kind": {
                              "const": "currency"
                            },
                            "currencyId": {
                              "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/semanticKey"
                            },
                            "quantity": {
                              "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/positiveInt64"
                            }
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "lineIndex",
                            "definitionVersion",
                            "kind",
                            "itemId",
                            "quantity"
                          ],
                          "properties": {
                            "lineIndex": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 62
                            },
                            "definitionVersion": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 2147483647
                            },
                            "kind": {
                              "const": "item_stack"
                            },
                            "itemId": {
                              "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/semanticKey"
                            },
                            "quantity": {
                              "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/positiveInt64"
                            }
                          }
                        }
                      ]
                    }
                  },
                  "deliveryCheckpoint": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "feedRevision",
                      "visibilityGeneration",
                      "logEpoch"
                    ],
                    "properties": {
                      "feedRevision": {
                        "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/positiveInt64"
                      },
                      "visibilityGeneration": {
                        "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/positiveInt64"
                      },
                      "logEpoch": {
                        "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/uuid"
                      }
                    }
                  }
                },
                "x-orderedLineIndices": true
              },
              "launchAllowed": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "receipt": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "recoveryResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intents",
        "nextIntentId"
      ],
      "properties": {
        "intents": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/intentState"
          }
        },
        "nextIntentId": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://contracts.gindemit.invalid/v1/schemas/common.schema.json#/$defs/uuidV7"
            }
          ]
        }
      }
    }
  }
}
